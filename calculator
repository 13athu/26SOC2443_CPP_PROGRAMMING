#include <iostream>
using namespace std;
int main()
{
    float a,b;
    char op;

    cout<<"a= ";
    cin>>a;

    cout<<"b= ";
    cin>>b;

    cout<<"choose your operation ( + , - , * , / )"<<endl;
    cin>>op;

    if (op == '+')
    {
        cout<<"a+b= "<<a+b<<endl;
    }
    else if (op == '-')
    {
        cout<<"a-b= "<<a-b<<endl;
    }
    else if ( op == '*')
    {
        cout<<"a*b= "<<a*b<<endl;
    }
    else if ( op == '/')
    {if (b != 0)
        {
            cout<<"a/b= "<<a/b<<endl;
        }
    }
    else{
        cout<<"Operation cant be done"<<endl;

    }
    return 0;
}
